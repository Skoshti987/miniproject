# KrishSathi Environment Variables
# Copy this file to .env and fill in your actual values

# ===========================================
# FIREBASE CONFIGURATION
# ===========================================
# Get these from Firebase Console > Project Settings > General > Your apps
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id_here
FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
FIREBASE_APP_ID=your_app_id_here
FIREBASE_MEASUREMENT_ID=your_measurement_id_here

# Firebase Admin SDK (for backend)
FIREBASE_ADMIN_SDK_PATH=./firebase-admin-key.json
FIREBASE_DATABASE_URL=https://your_project_id-default-rtdb.firebaseio.com/

# ===========================================
# APPLICATION CONFIGURATION
# ===========================================
NODE_ENV=development
REACT_APP_API_URL=http://localhost:8080/api
REACT_APP_FIREBASE_CONFIG=firebase

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
# Primary database (PostgreSQL - optional if using Firebase)
DATABASE_URL=jdbc:postgresql://localhost:5432/krishsathi
DATABASE_USERNAME=krishsathi
DATABASE_PASSWORD=krishsathi123

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379

# ===========================================
# EXTERNAL API KEYS
# ===========================================
# Weather API
WEATHER_API_KEY=your_weather_api_key_here
WEATHER_BASE_URL=https://api.openweathermap.org/data/2.5

# OpenAI API (for LLM integration)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1

# Google Cloud (for additional services)
GOOGLE_CLOUD_PROJECT_ID=your_project_id_here
GOOGLE_APPLICATION_CREDENTIALS=./google-cloud-key.json

# ===========================================
# SECURITY CONFIGURATION
# ===========================================
JWT_SECRET=your_jwt_secret_key_here
ENCRYPTION_KEY=your_encryption_key_here

# ===========================================
# NOTIFICATION CONFIGURATION
# ===========================================
# Firebase Cloud Messaging
FCM_SERVER_KEY=your_fcm_server_key_here

# SMS Gateway
SMS_API_KEY=your_sms_api_key_here
SMS_API_URL=https://api.sms-gateway.com

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here

# ===========================================
# FILE STORAGE CONFIGURATION
# ===========================================
# Firebase Storage
FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com

# Local file storage (fallback)
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# ===========================================
# ML/AI CONFIGURATION
# ===========================================
# TensorFlow Model Path
TF_MODEL_PATH=./models
TF_MODEL_CONFIDENCE_THRESHOLD=0.7

# Vector Database (for RAG)
VECTOR_DB_URL=your_vector_db_url_here
VECTOR_DB_API_KEY=your_vector_db_api_key_here

# ===========================================
# MONITORING & ANALYTICS
# ===========================================
# Google Analytics
GA_MEASUREMENT_ID=your_ga_measurement_id_here

# Sentry (Error tracking)
SENTRY_DSN=your_sentry_dsn_here

# ===========================================
# DEVELOPMENT CONFIGURATION
# ===========================================
DEBUG=true
LOG_LEVEL=debug
ENABLE_CORS=true
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ===========================================
# PRODUCTION CONFIGURATION
# ===========================================
# SSL Configuration
SSL_CERT_PATH=./ssl/cert.pem
SSL_KEY_PATH=./ssl/private.key

# Domain Configuration
DOMAIN=krishsathi.in
API_DOMAIN=api.krishsathi.in
