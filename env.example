# KrishSathi Environment Variables
# Copy this file to .env and fill in your actual values

# ===========================================
# FRONTEND CONFIGURATION
# ===========================================
REACT_APP_API_URL=http://localhost:8080/api

# ===========================================
# APPLICATION CONFIGURATION
# ===========================================
NODE_ENV=development

# Backend
PORT=8080

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
# MongoDB (MERN)
MONGO_URI=mongodb://localhost:27017/krishsathi

# ===========================================
# EXTERNAL API KEYS
# ===========================================
# Weather API
WEATHER_API_KEY=your_weather_api_key_here
WEATHER_BASE_URL=https://api.openweathermap.org/data/2.5

# Groq API (for LLM integration)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Google Cloud (for additional services)
GOOGLE_CLOUD_PROJECT_ID=your_project_id_here
GOOGLE_APPLICATION_CREDENTIALS=./google-cloud-key.json

# ===========================================
# SECURITY CONFIGURATION
# ===========================================
JWT_SECRET=your_jwt_secret_key_here
ENCRYPTION_KEY=your_encryption_key_here

# ===========================================
# NOTIFICATION CONFIGURATION
# ===========================================
# SMS Gateway
SMS_API_KEY=your_sms_api_key_here
SMS_API_URL=https://api.sms-gateway.com

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here

# ===========================================
# FILE STORAGE CONFIGURATION
# ===========================================
# Local file storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# ===========================================
# ML/AI CONFIGURATION
# ===========================================
# TensorFlow Model Path
TF_MODEL_PATH=./models
TF_MODEL_CONFIDENCE_THRESHOLD=0.7

# Vector Database (for RAG)
VECTOR_DB_URL=your_vector_db_url_here
VECTOR_DB_API_KEY=your_vector_db_api_key_here

# ===========================================
# MONITORING & ANALYTICS
# ===========================================
# Google Analytics
GA_MEASUREMENT_ID=your_ga_measurement_id_here

# Sentry (Error tracking)
SENTRY_DSN=your_sentry_dsn_here

# ===========================================
# DEVELOPMENT CONFIGURATION
# ===========================================
DEBUG=true
LOG_LEVEL=debug
ENABLE_CORS=true
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ===========================================
# PRODUCTION CONFIGURATION
# ===========================================
# SSL Configuration
SSL_CERT_PATH=./ssl/cert.pem
SSL_KEY_PATH=./ssl/private.key

# Domain Configuration
DOMAIN=krishsathi.in
API_DOMAIN=api.krishsathi.in
