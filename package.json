{
  "name": "krishsathi",
  "version": "1.0.0",
  "description": "KrishSathi - Agricultural Assistance PWA",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "cd frontend && npm start",
    "dev:backend": "cd backend && mvnw.cmd spring-boot:run",
    "build": "cd frontend && npm run build",
    "start": "cd backend && mvnw.cmd spring-boot:run",
    "install:all": "npm install && cd frontend && npm install --legacy-peer-deps && cd ../backend && mvnw.cmd clean install"
  },
  "keywords": ["agriculture", "pwa", "malayalam", "hindi", "marathi", "voice", "ml"],
  "author": "KrishSathi Team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
